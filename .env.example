# Copy this file to .env and fill in the blanks. .env is git-ignored.

# Nebius Token Factory key (tokenfactory.nebius.com -> API keys)
NEBIUS_API_KEY=
# Tavily key (app.tavily.com), leave blank to disable web research
TAVILY_API_KEY=

# Models served by Token Factory
TRIAGE_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
WRITER_MODEL=nvidia/nemotron-3-super-120b-a12b
VOICE_MODEL=nvidia/Nemotron-3_5-Lightning
OPS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Behaviour
DRY_RUN=true
LEAD_RESEARCH=true
POLL_INTERVAL_SECS=60
BUSINESS_PROFILE=demo_tree_service.md
PROPERTY_PROFILE=demo_property_ops.md
REPLY_DOMAIN=example.com
AGENT_NAME=Aria
VOICE_PORT=8000

# Texts through Twilio (optional). Texts are logged, not sent, until SMS_DRY_RUN=false.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_DRY_RUN=true
# Demo: send every text to this one number instead, labelled with who it was for. Blank in production.
DEMO_PHONE=
# Staff emails (emergency alerts, morning summary). DEMO_EMAIL redirects them all to one inbox for demos.
EMAIL_NOTIFY_DRY_RUN=false
DEMO_EMAIL=
# Emergency acknowledgement calls: ring the contractor, press 1 to accept; escalate after ESCALATION_MINUTES
CALL_CONTRACTORS=true
ESCALATION_MINUTES=10
# Public https address of this server for Twilio callbacks; blank = read the tunnel's from tunnel.log
PUBLIC_URL=

# Mailbox for the live email agent (demo.py does not need this). Gmail needs an App Password.
EMAIL_USERNAME=
EMAIL_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
